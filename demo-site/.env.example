# Browser-safe Supabase connection. Never place a secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Must also be added to Supabase Auth > URL Configuration > Redirect URLs.
# Omit it to use the site origin that the user currently opened.
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/

# The root/admin routes use Supabase; /demo keeps isolated sample state.
NEXT_PUBLIC_DATA_MODE=live
NEXT_PUBLIC_DISPLAY_TIMEZONE=Asia/Seoul

# Server-only, trusted static-asset origin for the bundled PDF font.
# Never populate from a request Host/forwarded header. Set explicitly for any future host.
REPORT_ASSET_ORIGIN=http://localhost:3000

# Server-only Storage reader, after the app verifies the current user's report access.
# Supply a modern secret using the host's secret settings. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEYS={"default":"sb_secret_replace_in_server_environment"}
